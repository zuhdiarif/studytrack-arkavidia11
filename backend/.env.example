# Port server backend
PORT=4000

# Kunci penandatangan JWT (ganti dengan string acak panjang di production)
JWT_SECRET=studytrack-secret-key-change-this

# Opsional: URL koneksi PostgreSQL / Supabase. Jika dikosongkan, backend memakai JSON fallback (backend/db.json).
DATABASE_URL=

# Opsional: Daftar origin frontend yang diizinkan oleh CORS (pisahkan dengan koma), contoh: http://localhost:5173
FRONTEND_URL=

# Opsional: API key Google Gemini untuk fitur Rencana Kerja AI (POST /api/tasks/:id/ai-plan).
# Jika dikosongkan, backend otomatis menggunakan Mode Panduan Lokal (fallback deterministik).
GEMINI_API_KEY=

# Opsional: Model Gemini yang digunakan (default: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Zona waktu server untuk sinkronisasi input datetime-local
TZ=Asia/Jakarta
